<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole Android app definition. There is no Gradle project and no Java source
  behind this file — see docs/notes/android-build.md.

  `android:hasCode="false"` is the load-bearing line: it tells the framework there
  is no `classes.dex` in this APK, which is only true because the activity class
  is `android.app.NativeActivity` out of the framework itself rather than the
  GameActivity one that would arrive in an AAR. Drop that attribute and the
  installer rejects the package; add a Java class and it has to come back.

  `android.app.lib_name` is how NativeActivity finds us: it `System.loadLibrary`s
  that name out of `lib/<abi>/`, so it must track the cdylib's crate name
  (`libcartopolis_android.so` → `cartopolis_android`).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="eu.garage44.cartopolis">

    <!-- **No version attributes here, deliberately.** `aapt2 link`'s version-code
         and version-name flags (spelled without their leading dashes: a double
         hyphen is illegal *inside* an XML comment) *inject* a value and only
         when the manifest carries none — they do not overwrite one that is
         already there. This file used to declare `versionCode="1"` and
         `versionName="1.0.0-local"` under a comment claiming aapt2 would
         overwrite them, and the opposite was true: the flags were discarded
         silently and **every APK ever published shipped as version 1 /
         1.0.0-local**.

         That cost more than tidiness. `deploy-android.yml` computes a monotonic
         code from the run number, offset above any local build, precisely so a
         download from the install page can always update a sideloaded one — a
         guarantee that never existed. And nothing on a device could say which
         build it was: the crash reporter's `CARTO_BUILD_SHA` (baked into the
         binary from the same version-name) said `1.0.0+087e7198` while Android's
         app info said `1.0.0-local`, so the two identifiers for one build
         disagreed. Confirmed on an emulator 2026-08-15, from a share sheet
         showing one and `dumpsys` the other.

         `build-apk.sh` supplies both on every path, including a hand build (it
         falls back to the commit count), so there is nothing to fall back to
         here. See its version block for why a CI code is deliberately larger
         than a local one. -->

    <!-- API 28 because that is where Android's Vulkan support becomes something
         wgpu can rely on; below it the GLES fallback would be the only backend and
         this client has never been run on one. 34 as the target keeps the modern
         windowing behaviour (edge-to-edge, gesture nav) rather than the
         compatibility shims older targets opt into. -->
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <!-- Advisory, not enforced: it keeps the Play listing (and `adb install`'s
         warnings) honest about needing a Vulkan device, without hard-failing an
         install on a device whose driver reports oddly. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="false" />

    <!-- The entire map — OSM tiles, 3DBAG buildings, AHN heights, GFS clouds — is
         streamed. Without this the app starts and renders an empty globe. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Location. These were deliberately absent until the JNI provider existed,
         on the rule that a permission the app cannot act on is a prompt that buys
         the user nothing: `platform::location` had only a web arm, and
         `LocationWatch::available()` said so rather than inventing a fix. That
         changed with `platform::android` — driver mode now follows the device on
         the phone instead of the avatar.

         Both are listed, and FINE is not a superset of COARSE at the manifest
         level: since API 31 the permission dialog offers the user a Precise /
         Approximate choice and will only offer Approximate if COARSE is declared
         too. Requesting FINE alone means a user who wants to share a rough
         position has to refuse outright. The provider accepts either grant and
         reports the resulting accuracy honestly (`GpsFix::accuracy_m`).

         These are *dangerous* permissions, so from API 23 the manifest entry only
         makes them requestable — the app must also ask at runtime, which
         `platform::android::request_permission` does. There is no background
         location here and there must not be: the fix is only read while driver
         mode is on and the app is on screen, so ACCESS_BACKGROUND_LOCATION would
         be a Play-review conversation in exchange for nothing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Advisory: the app is fully usable without GNSS (it is a map viewer first),
         so a device with no location hardware must still be able to install. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- The compass (`platform::orientation`), which turns the map with the phone
         when the locate button is lit. No permission: the rotation vector is not a
         restricted sensor, so the only manifest entry it wants is this advisory
         one, and it is `required="false"` for the same reason the GNSS line above
         is — a device with no magnetometer loses the heading and keeps the map. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <!-- Hold the screen on while driving. A *normal* permission: granted at
         install, never prompted for.

         The usual way to keep a screen lit is FLAG_KEEP_SCREEN_ON, which needs no
         permission at all — and is unreachable here for a reason that is about
         android-activity's lock rather than about Android
         (`platform::android::set_keep_screen_on` has the deadlock). A wake lock
         is the same effect through a thread-safe binder call, and this line is
         what it costs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- A photo on a saved place (`platform::photo`, docs/notes/place-photos.md).
         Capped at API 28 on purpose: from 29 scoped storage lets an app insert its
         own row into the MediaStore with no permission at all, and that insert is
         how the camera app is given somewhere to write. Below 29 there is no
         RELATIVE_PATH column and the same insert needs this, so it is requested at
         runtime on those devices only.

         Note what is deliberately **absent**: android.permission.CAMERA.
         ACTION_IMAGE_CAPTURE needs no permission from the app that sends it — but
         Android's contract says an app that *declares* CAMERA must also hold it
         before the intent is honoured. Declaring it would buy a runtime prompt in
         exchange for something already permitted. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Advisory for the same reason as the GNSS entry above: a tablet with no
         camera must still install; the menu entry simply fails with "no camera
         app" when the intent finds no handler. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Cartopolis"
        android:icon="@mipmap/icon"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <!-- Every entry in `configChanges` below is a configuration change that
             would otherwise destroy and recreate the activity — which for a
             NativeActivity means tearing the process's window down and running
             `android_main` again, i.e. the app restarting when you rotate the phone
             or the system flips to dark mode. Handling them ourselves hands winit a
             resize instead. -->
        <!-- `android:theme` below is ours, not the stock fullscreen theme it used
             to be — and the difference is the first thing anyone installing this
             sees. A NativeActivity paints nothing until the surface exists and
             Bevy has started, so the theme's `windowBackground` *is* the app for
             the first several seconds. See res/values/styles.xml.

             The comment lives here, above the tag, and not among the attributes
             where it was first written: a comment is a node, and a node cannot
             sit inside another element's attribute list. XML has no diagnostic
             kinder than "not well-formed" for it. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="user"
            android:theme="@style/Theme.Cartopolis"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|fontScale">

            <meta-data
                android:name="android.app.lib_name"
                android:value="cartopolis_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
