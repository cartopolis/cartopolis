#!/usr/bin/env bash
#
# Claude Code PostToolUse hook (Read|Edit|Write): name the docs/notes that apply
# to the file just touched. Every note carries `triggers:` front-matter saying
# when to read it; this is what reads them, so a note's knowledge reaches the
# agent working on its files without being pasted into CLAUDE.md.
#
# A trigger matches when it is a file name (`routing.rs`), a path or path prefix
# (`crates/atlas`, `assets/shaders/patched/`, `systems/map/water.rs`) or a module
# path whose last segment is the file's module (`systems::water` → water.rs or
# water/mod.rs). Prose and keyword triggers are for grep, not for this.
#
# Each note is named once per session. FAILS OPEN: anything unexpected exits 0
# and costs nothing.
set -uo pipefail
command -v jq >/dev/null 2>&1 || exit 0

payload=$(cat 2>/dev/null) || exit 0
file=$(printf '%s' "$payload" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
session=$(printf '%s' "$payload" | jq -r '.session_id // "none"' 2>/dev/null)
[ -n "$file" ] || exit 0

# The checkout the file is in, found by walking up to its docs/notes — so a
# session working across several worktrees reads each one's own notes.
dir=$(dirname "$file")
root=""
while [ "$dir" != "/" ] && [ -n "$dir" ]; do
    if [ -f "$dir/docs/notes/README.md" ]; then root=$dir; break; fi
    dir=$(dirname "$dir")
done
[ -n "$root" ] || exit 0
rel=${file#"$root"/}
case "$rel" in docs/notes/*|docs/adr/*|docs/abstract/*) exit 0 ;; esac

base=$(basename "$rel")
stem=${base%.*}
# A module's own file is mod.rs; its name is the directory's.
[ "$stem" = mod ] && stem=$(basename "$(dirname "$rel")")

matches=$(awk -v rel="$rel" -v base="$base" -v stem="$stem" '
    function hit(tok,   t, n, parts, last) {
        sub(/^\.\//, "", tok); sub(/^\/+/, "", tok); sub(/\.+$/, "", tok)
        # A single directory (`systems/`) names a whole tree, which is every
        # file and so no file in particular; two segments (`crates/atlas`) do.
        sub(/\/+$/, "", tok)
        if (tok == "") return 0
        if (index(tok, "#") > 0) {
            n = split(tok, parts, "#")
            last = parts[n]
            if (last ~ /^[a-z][a-z0-9_]+$/ && last !~ /^(mod|lib|main|plugin|tests?)$/ && last == stem) return 1
            return 0
        }
        if (index(tok, "/") > 0) {
            if (rel == tok) return 1
            if (index(rel, tok "/") == 1) return 1
            if (index("/" rel, "/" tok "/") > 0) return 1
            t = "/" tok
            if (length(rel) >= length(t) && substr("/" rel, length(rel) + 2 - length(t)) == t) return 1
            return 0
        }
        if (tok ~ /\.(rs|wesl|wgsl|ts|tsx|js|sh|toml|json|py|yml|yaml|java|xml|html|css|kt)$/ && tok == base) return 1
        return 0
    }
    # A note without a heading is still named, by its file.
    function flush() { if (found) print prev "\t" prev; found = 0 }
    FNR == 1 { flush(); prev = FILENAME; infm = ($0 == "---"); intrig = 0; next }
    END { flush() }
    infm && /^---[ \t]*$/ { infm = 0; next }
    infm {
        if ($0 ~ /^triggers:/) intrig = 1
        else if ($0 ~ /^[a-z_]+:/) intrig = 0
        if (intrig && !found) {
            line = $0
            gsub(/::/, "#", line)
            n = split(line, toks, /[^A-Za-z0-9_.\/#-]+/)
            for (i = 1; i <= n; i++) if (hit(toks[i])) { found = 1; break }
        }
        next
    }
    found && /^# / { print FILENAME "\t" substr($0, 3); found = 0 }
' "$root"/docs/notes/*.md 2>/dev/null) || exit 0
[ -n "$matches" ] || exit 0

# Once per session per note: a file read five times should not repeat itself.
state_dir=${TMPDIR:-/tmp}/cartopolis-note-triggers
mkdir -p "$state_dir" 2>/dev/null
state=$state_dir/$session
touch "$state" 2>/dev/null
lines=""
while IFS=$'\t' read -r path title; do
    note=${path#"$root"/}
    grep -qxF "$note" "$state" 2>/dev/null && continue
    echo "$note" >> "$state" 2>/dev/null
    lines+="- \`$note\` — $title"$'\n'
done <<< "$matches"
[ -n "$lines" ] || exit 0

context="Notes whose triggers name \`$rel\` — read the ones that bear on your change before making it:"$'\n'"$lines"
printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":%s}}\n' \
    "$(printf '%s' "$context" | jq -Rs .)"
