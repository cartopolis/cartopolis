#!/usr/bin/env bash
#
# Bind this worktree to a viberfox ticket.
#
#   ./file-issue --title "..." [--branch feat/slug] [--label driven] < body.md
#   ./file-issue --bind 23
#
# The binding is a marker at $(git rev-parse --git-dir)/viberfox-ticket:
# per-worktree, never committed, and what the Stop and SessionStart hooks key
# on. It holds the branch name in full, because those hooks are pure git with no
# credentials and cannot resolve an issue number into a slug.
#
# This does NOT create, switch or push branches. Worktrees stay detached — Zed
# owns that lifecycle — and code travels as `push HEAD:<branch>` from the hook.

set -euo pipefail

env_file="${VIBERFOX_FORGEJO_ENV:-$HOME/.config/viberfox/forgejo.env}"
[ -f "$env_file" ] || { echo "missing $env_file — see docs/workflow.md" >&2; exit 1; }
set -a; . "$env_file"; set +a
: "${FORGEJO_TOKEN:?not set in $env_file}"
API="${FORGEJO_API:-https://code.garage44.eu/api/v1}"
REPO="${FORGEJO_REPO:-jeroen/viberfox}"

title=""; branch=""; labels="driven"; bind=""
while [ $# -gt 0 ]; do
    case "$1" in
        --title)  title="$2"; shift 2 ;;
        --branch) branch="$2"; shift 2 ;;
        --label)  labels="$2"; shift 2 ;;
        --bind)   bind="$2"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

git_dir=$(git rev-parse --git-dir)
marker="$git_dir/viberfox-ticket"
common=$(git rev-parse --git-common-dir)

api() { curl -sf -H "Authorization: token $FORGEJO_TOKEN" -H "Content-Type: application/json" "$@"; }

label_id() {
    api "$API/repos/$REPO/labels?limit=100" | LBL="$1" python3 -c '
import json, os, sys
print({l["name"]: l["id"] for l in json.load(sys.stdin)}.get(os.environ["LBL"], ""))'
}

# A ticket may be held by exactly one local worktree. Git used to enforce this
# for free — it refuses one branch in two checkouts — but nothing here uses local
# branches any more, so the claim has to be checked directly. Catching it now
# beats catching it at push time, after the work.
claimed_elsewhere() {
    _n="$1"
    for _m in "$common"/worktrees/*/viberfox-ticket; do
        [ -f "$_m" ] || continue
        [ "$_m" = "$marker" ] && continue
        if [ "$(sed -n 's/^issue=//p' "$_m" | head -1)" = "$_n" ]; then
            printf '%s' "$(dirname "$_m")"
            return 0
        fi
    done
    return 1
}

write_marker() {
    printf 'issue=%s\nbranch=%s\nurl=%s\ntitle=%s\n' "$1" "$2" "$3" "$4" > "$marker"
}

# --- bind mode ---------------------------------------------------------------

if [ -n "$bind" ]; then
    issue=$(api "$API/repos/$REPO/issues/$bind") ||
        { echo "no such issue: #$bind" >&2; exit 1; }

    eval "$(printf '%s' "$issue" | python3 -c '
import json, sys, re, shlex
d = json.load(sys.stdin)
body = d.get("body") or ""
m = re.search(r"^\s*branch:\s*`?([A-Za-z0-9._/-]+)`?\s*$", body, re.I | re.M)
print("i_title=" + shlex.quote(d["title"]))
print("i_url=" + shlex.quote(d["html_url"]))
print("i_branch=" + shlex.quote(m.group(1) if m else ""))
print("i_labels=" + shlex.quote(",".join(l["name"] for l in d.get("labels", []))))
print("i_state=" + shlex.quote(d["state"]))
')"

    case ",$i_labels," in
        *,agent:running,*)
            echo "#$bind is running on the VPS right now — wait for it to finish." >&2
            exit 1 ;;
    esac
    [ "$i_state" = "open" ] || { echo "#$bind is closed." >&2; exit 1; }

    if held=$(claimed_elsewhere "$bind"); then
        echo "#$bind is already claimed by another worktree: $held" >&2
        exit 1
    fi

    [ -n "$i_branch" ] ||
        { echo "#$bind has no 'Branch:' line — nothing to attach to." >&2; exit 1; }

    # Taking a ticket back means detaching onto its remote tip. Anything here
    # that is not on origin would become unreachable, so refuse rather than
    # silently orphan it.
    [ -z "$(git status --porcelain)" ] ||
        { echo "working tree is dirty — commit or stash before binding." >&2; exit 1; }

    git fetch -q origin "$i_branch" 2>/dev/null || true
    if [ "$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 0)" -gt 0 ] &&
       ! git merge-base --is-ancestor HEAD FETCH_HEAD 2>/dev/null; then
        echo "this worktree has commits that are not on origin/$i_branch — push or drop them first." >&2
        exit 1
    fi
    git rev-parse -q --verify FETCH_HEAD >/dev/null 2>&1 &&
        { git checkout -q --detach FETCH_HEAD; echo "detached onto origin/$i_branch" >&2; }

    # Claim it back from the autonomous lane.
    did=$(label_id driven)
    [ -n "$did" ] && api -o /dev/null -X POST "$API/repos/$REPO/issues/$bind/labels" -d "{\"labels\":[$did]}"
    for l in agent agent:done agent:failed agent:refined autonomous; do
        lid=$(label_id "$l")
        [ -n "$lid" ] && api -o /dev/null -X DELETE "$API/repos/$REPO/issues/$bind/labels/$lid" 2>/dev/null || true
    done

    write_marker "$bind" "$i_branch" "$i_url" "$i_title"
    echo "bound to #$bind ($i_branch)" >&2
    echo "$bind"
    exit 0
fi

# --- create mode -------------------------------------------------------------

[ -n "$title" ] || { echo "--title is required (or --bind <n>)" >&2; exit 2; }

infer_type() {
    _t=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$_t" in
        *crash*|*panic*|*broken*|*wrong*|*incorrect*|*regress*|*fails*|*bug*) echo fix ;;
        *slow*|*sluggish*|*performance*|*fps*|*lag*|*stutter*|*faster*) echo perf ;;
        *document*|*docs*|*readme*) echo docs ;;
        *refactor*|*cleanup*|*"clean up"*|*tidy*) echo refactor ;;
        *test*|*coverage*) echo test ;;
        *) echo feat ;;
    esac
}

slugify() {
    printf '%s' "$1" |
        tr '[:upper:]' '[:lower:]' |
        sed "s/'//g; s/[^a-z0-9]\{1,\}/ /g" |
        tr ' ' '\n' | grep -vxE 'a|an|the|is|are|be|to|of|in|on|for|when|while|and|or|it|its|we|i|im|my|me|should|would|could|please|can|that|this|there|at|as|with|over|some|somehow' |
        grep -v '^$' | head -4 | paste -sd- - | cut -c1-48 | sed 's/-*$//'
}

[ -n "$branch" ] || branch="$(infer_type "$title")/$(slugify "$title")"
case "$branch" in */*) ;; *) branch="$(infer_type "$title")/$branch" ;; esac

body=$(cat)

# Validate labels before anything exists, so a typo fails cheaply.
label_ids=$(api "$API/repos/$REPO/labels?limit=100" | LABELS="$labels" python3 -c '
import json, os, sys
want = {s.strip() for s in os.environ["LABELS"].split(",") if s.strip()}
have = {l["name"]: l["id"] for l in json.load(sys.stdin)}
missing = want - have.keys()
if missing:
    sys.exit("no such label(s) in the repo: " + ", ".join(sorted(missing)))
print(json.dumps([have[n] for n in sorted(want)]))
')

# Created unlabelled: the branch name is not knowable until the number exists,
# and the Branch: line must be in the body before any label makes the issue
# visible to the watcher — one picked up in that window would cut its own branch
# and ignore this work entirely.
response=$(TITLE="$title" BODY="$body" python3 -c '
import json, os
print(json.dumps({"title": os.environ["TITLE"], "body": os.environ["BODY"]}))
' | api -X POST "$API/repos/$REPO/issues" -d @-)

read -r number url <<EOF
$(printf '%s' "$response" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d["number"], d["html_url"])
')
EOF

# Inject the number: fix/road-joins -> fix/23-road-joins, idempotent if already
# numbered ("50-x" is not treated as containing "5-").
case "$branch" in
    */"$number"-*) ;;
    *) branch="${branch%%/*}/$number-${branch#*/}" ;;
esac

BODY=$(printf '%s\n\n---\n\nBranch: `%s`\n' "$body" "$branch") python3 -c '
import json, os
print(json.dumps({"body": os.environ["BODY"]}))
' | api -o /dev/null -X PATCH "$API/repos/$REPO/issues/$number" -d @-

api -o /dev/null -X POST "$API/repos/$REPO/issues/$number/labels" -d "{\"labels\":$label_ids}"

write_marker "$number" "$branch" "$url" "$title"

echo "$url" >&2
echo "bound this worktree to #$number ($branch)" >&2
echo "$number"
