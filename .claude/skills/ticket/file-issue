#!/usr/bin/env bash
#
# File a viberfox issue from a local session. Body on stdin.
#
#   ./file-issue --title "..." [--branch feat/x] [--label driven] < body.md
#
# Prints the issue number on stdout and the URL on stderr.
#
# Credentials come from ~/.config/viberfox/forgejo.env (0600, scope write:issue).
# The board placement is deliberately NOT done here: Forgejo 16 has no kanban
# API, so a card can only be moved by a *session* login as the bot, and putting
# the bot's password on the workstation to save one poll cycle would be a poor
# trade. The watcher seeds the card into Backlog within 30 s instead.

set -euo pipefail

env_file="${VIBERFOX_FORGEJO_ENV:-$HOME/.config/viberfox/forgejo.env}"
[ -f "$env_file" ] || { echo "missing $env_file — see docs/workflow.md" >&2; exit 1; }
set -a; . "$env_file"; set +a
: "${FORGEJO_TOKEN:?not set in $env_file}"
API="${FORGEJO_API:-https://code.garage44.eu/api/v1}"
REPO="${FORGEJO_REPO:-jeroen/viberfox}"

title=""; branch=""; labels="driven"
while [ $# -gt 0 ]; do
    case "$1" in
        --title)  title="$2"; shift 2 ;;
        --branch) branch="$2"; shift 2 ;;
        --label)  labels="$2"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$title" ] || { echo "--title is required" >&2; exit 2; }

# Derive a Conventional-Commits type and slug from the title. Mirrors the rules
# in watcher.ts so both lanes produce the same shape, and means the caller never
# has to think of a branch name.
infer_type() {
    _t=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$_t" in
        *crash*|*panic*|*broken*|*wrong*|*incorrect*|*regress*|*fails*|*bug*) echo fix ;;
        *slow*|*sluggish*|*performance*|*fps*|*lag*|*stutter*|*faster*) echo perf ;;
        *document*|*docs*|*readme*) echo docs ;;
        *refactor*|*cleanup*|*"clean up"*|*tidy*) echo refactor ;;
        *test*|*coverage*) echo test ;;
        *) echo feat ;;
    esac
}

slugify() {
    printf '%s' "$1" |
        tr '[:upper:]' '[:lower:]' |
        sed "s/'//g; s/[^a-z0-9]\{1,\}/ /g" |
        tr ' ' '\n' | grep -vxE 'a|an|the|is|are|be|to|of|in|on|for|when|while|and|or|it|its|we|i|im|my|me|should|would|could|please|can|that|this|there|at|as|with|over|some|somehow' |
        grep -v '^$' | head -4 | paste -sd- - | cut -c1-48 | sed 's/-*$//'
}

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# The branch name is never something to think about. Three sources, in order:
# an explicit --branch (the agent proposes one, since it knows what the change
# is), the branch already checked out, or the issue title.
if [ -z "$branch" ]; then
    case "$current_branch" in
        main | master | HEAD | '') branch="$(infer_type "$title")/$(slugify "$title")" ;;
        *) branch="$current_branch" ;;
    esac
fi
[ "${branch%/*}" = "$branch" ] && branch="$(infer_type "$title")/$branch"

body=$(cat)

# Insert the issue number into a branch name, keeping the Conventional-Commits
# style prefix the repo already uses: fix/road-joins -> fix/12-road-joins.
# A name that already carries this number as a segment is returned untouched, so
# re-filing is idempotent. `50-x` is not treated as containing `5-`.
number_branch() {
    _n="$1" _name="$2"
    case "$_name" in
        "$_n"-* | */"$_n"-*) printf '%s' "$_name"; return ;;
    esac
    case "$_name" in
        */*) printf '%s/%s-%s' "${_name%%/*}" "$_n" "${_name#*/}" ;;
        *)   printf '%s-%s' "$_n" "$_name" ;;
    esac
}

# Resolve label names to ids up front: a typo'd label should fail before an
# issue exists, not after.
label_ids=$(curl -sf -H "Authorization: token $FORGEJO_TOKEN" \
    "$API/repos/$REPO/labels?limit=100" |
    LABELS="$labels" python3 -c '
import json, os, sys
want = {s.strip() for s in os.environ["LABELS"].split(",") if s.strip()}
have = {l["name"]: l["id"] for l in json.load(sys.stdin)}
missing = want - have.keys()
if missing:
    # Not an f-string: a backslash inside an f-string expression is a syntax
    # error before Python 3.12, and this file is run by whatever python3 the
    # workstation has.
    sys.exit("no such label(s) in the repo: " + ", ".join(sorted(missing)))
print(json.dumps([have[n] for n in sorted(want)]))
')

# Create UNLABELLED. The branch name is not knowable until the issue number
# exists, and the `Branch:` line has to be in the body before any label makes the
# issue visible to the watcher — an `agent`-labelled issue picked up in that
# window would cut a fresh branch and ignore the local work entirely.
response=$(TITLE="$title" BODY="$body" python3 -c '
import json, os
print(json.dumps({"title": os.environ["TITLE"], "body": os.environ["BODY"]}))
' | curl -sf -X POST \
    -H "Authorization: token $FORGEJO_TOKEN" \
    -H "Content-Type: application/json" \
    "$API/repos/$REPO/issues" -d @-)

read -r number url <<EOF
$(printf '%s' "$response" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d["number"], d["html_url"])
')
EOF

if [ -n "$branch" ]; then
    numbered=$(number_branch "$number" "$branch")

    case "$current_branch" in
        main | master | HEAD | '')
            # Working from main is the normal state of an editor sitting on the
            # repo, and it is the one state where none of this works: the Stop
            # hook skips main entirely, so no digest is published and no branch
            # is pushed, and the eventual push is rejected by branch protection
            # after the work is done. All three fail silently, so getting off
            # main is not a suggestion — it is what filing a ticket means.
            #
            # `switch -c` carries any uncommitted changes across, which is what
            # someone who started poking at the problem before filing wants.
            git switch -q -c "$numbered" 2>/dev/null ||
                git checkout -q -b "$numbered"
            echo "branch: created and checked out $numbered" >&2
            ;;
        "$numbered")
            : # already there, nothing to do
            ;;
        *)
            # A branch that exists nowhere but here can take the number. Once it
            # is on the remote, renaming would orphan the pushed branch — and any
            # agent-context ref published under the old name with it.
            if git show-ref --verify --quiet "refs/remotes/origin/$current_branch"; then
                echo "note: $current_branch is already on origin — leaving its name alone" >&2
                numbered="$current_branch"
            else
                git branch -m "$current_branch" "$numbered"
                echo "branch: renamed $current_branch -> $numbered" >&2
            fi
            ;;
    esac
    branch="$numbered"

    # The Branch: line is load-bearing, not decoration: it is the ONLY thing that
    # lets a takeover attach to this branch and its refs/agent-context digest
    # instead of cutting a fresh branch from main and ignoring the work.
    BODY=$(printf '%s\n\n---\n\nBranch: `%s`\n' "$body" "$branch") python3 -c '
import json, os
print(json.dumps({"body": os.environ["BODY"]}))
' | curl -sf -o /dev/null -X PATCH \
        -H "Authorization: token $FORGEJO_TOKEN" \
        -H "Content-Type: application/json" \
        "$API/repos/$REPO/issues/$number" -d @-
fi

# Label last: this is what makes the issue actionable to the watcher.
IDS="$label_ids" python3 -c '
import json, os
print(json.dumps({"labels": json.loads(os.environ["IDS"])}))
' | curl -sf -o /dev/null -X POST \
    -H "Authorization: token $FORGEJO_TOKEN" \
    -H "Content-Type: application/json" \
    "$API/repos/$REPO/issues/$number/labels" -d @-

echo "$url" >&2
echo "$number"
