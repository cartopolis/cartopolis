#!/usr/bin/env bash
#
# Hand this worktree's ticket to the autonomous agent on the VPS.
#
#   ./hand-over [--note "what is left to do"]
#
# Everything the remote side needs must exist before the label flips, because
# the watcher polls every 30 s and will start reading the moment it does:
#
#   1. leftovers swept into a wip commit — uncommitted work does NOT survive a
#      handover, and the digest only *reports* the loss, it cannot recover it
#   2. HEAD pushed to the ticket's branch
#   3. this session's digest confirmed present in the context repo
#   4. driven -> agent, and a comment saying where things stand
#
# Refuses without a ticket marker: there is nothing to hand over and nowhere to
# put it. Run /ticket first.

set -euo pipefail

note=""
while [ $# -gt 0 ]; do
    case "$1" in
        --note) note="$2"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

env_file="${CARTO_FORGEJO_ENV:-$HOME/.config/cartopolis/forgejo.env}"
[ -f "$env_file" ] || { echo "missing $env_file — see docs/workflow.md" >&2; exit 1; }
set -a; . "$env_file"; set +a
: "${FORGEJO_TOKEN:?not set in $env_file}"
API="${FORGEJO_API:-https://code.garage44.eu/api/v1}"
REPO="${FORGEJO_REPO:-jeroen/cartopolis}"
CONTEXT_REMOTE="${CARTO_AGENT_CONTEXT_REMOTE:-ssh://git@code.garage44.eu:2222/jeroen/cartopolis-agent-context.git}"

marker="$(git rev-parse --git-dir)/cartopolis-ticket"
[ -f "$marker" ] || {
    echo "this worktree is not bound to a ticket — run /ticket first." >&2; exit 1; }

issue=$(sed -n 's/^issue=//p' "$marker" | head -1)
branch=$(sed -n 's/^branch=//p' "$marker" | head -1)
title=$(sed -n 's/^title=//p' "$marker" | head -1)
[ -n "$issue" ] && [ -n "$branch" ] || { echo "marker unreadable: $marker" >&2; exit 1; }
dir=$(printf '%s' "$branch" | tr '/' '-')

api() { curl -sf -H "Authorization: token $FORGEJO_TOKEN" -H "Content-Type: application/json" "$@"; }
label_id() {
    api "$API/repos/$REPO/labels?limit=100" | LBL="$1" python3 -c '
import json, os, sys
print({l["name"]: l["id"] for l in json.load(sys.stdin)}.get(os.environ["LBL"], ""))'
}

# 1. Sweep. `git add -A` is safe here only because target/, data/, cache/, dist/
#    and .claude/worktrees/ are all gitignored — check .gitignore before trusting
#    this in another repo.
if [ -n "$(git status --porcelain)" ]; then
    git add -A
    git -c user.name="${GIT_AUTHOR_NAME:-$(git config user.name)}" \
        -c user.email="${GIT_AUTHOR_EMAIL:-$(git config user.email)}" \
        commit -q -m "wip: handover of #$issue

Uncommitted work swept up so the handover carries it. Amend or squash
this into real commits; it is not meant to survive review."
    echo "swept leftovers into a wip commit" >&2
fi

# 2. Push. Detached HEAD is the normal state, hence the explicit refspec. Never
#    forced: a rejection means the ticket moved under you, which needs a person.
ahead=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
if [ "$ahead" -eq 0 ]; then
    echo "nothing to hand over — no commits ahead of origin/main." >&2
    exit 1
fi
git push -q origin "HEAD:refs/heads/$branch" ||
    { echo "push to $branch rejected — someone else has moved it. Resolve by hand." >&2; exit 1; }
echo "pushed $ahead commit(s) to $branch" >&2

# 3. Confirm the reasoning is actually there. The Stop hook publishes per turn,
#    so it should be — but handing over on the assumption is how the remote agent
#    ends up with code and no idea why.
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
if git clone -q "$CONTEXT_REMOTE" "$tmp/ctx" 2>/dev/null; then
    sessions=$(find "$tmp/ctx/$dir" -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
else
    sessions=0
fi
if [ "$sessions" -eq 0 ]; then
    echo "WARNING: no chat digest under $dir/ in the context repo." >&2
    echo "The remote agent will get your code with no reasoning behind it." >&2
    echo "Usually means the Stop hook has not run in this worktree yet." >&2
else
    echo "$sessions session digest(s) available under $dir/" >&2
fi

# 4. Flip the lock, then say where things stand. Comment first so it is on the
#    issue before the watcher can claim it.
body="🤝 **Handed over from a local session.**

Branch \`$branch\` is pushed, $ahead commit(s) ahead of \`main\`.
Chat context: \`$dir/\` in the agent-context repo — $sessions session file(s), read oldest first.
$( [ -n "$note" ] && printf '\n**Where it stands:** %s\n' "$note" )
<sub>Continue this work; do not restart it. The digests hold the alternatives already rejected.</sub>"

BODY="$body" python3 -c '
import json, os
print(json.dumps({"body": os.environ["BODY"]}))' |
    api -o /dev/null -X POST "$API/repos/$REPO/issues/$issue/comments" -d @-

aid=$(label_id agent)
[ -n "$aid" ] && api -o /dev/null -X POST "$API/repos/$REPO/issues/$issue/labels" -d "{\"labels\":[$aid]}"
for l in driven local; do
    lid=$(label_id "$l")
    [ -n "$lid" ] && api -o /dev/null -X DELETE "$API/repos/$REPO/issues/$issue/labels/$lid" 2>/dev/null || true
done

# The binding is released: this worktree no longer owns the ticket, and the Stop
# hook must stop publishing into it from here.
rm -f "$marker"

echo "#$issue handed over — driven -> agent. The watcher picks it up within 30 s." >&2
echo "$issue"
