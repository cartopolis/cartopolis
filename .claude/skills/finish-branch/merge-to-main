#!/usr/bin/env bash
#
# Land the current worktree's branch on `main`.
#
#   ./merge-to-main [--scope auto|min|full] [--verify-only] [--dry-run]
#                   [--allow-unverified] [--deploy wasm,apk,…]
#
# Rebase onto `origin/main`, run CI's gate locally (`verify-branch`), push the
# branch and fast-forward `main` to it. No pull request.
# `--deploy` then publishes the landed commit to the named `midas deploy`
# targets (sim, atlas, web, wasm, apk), one after another, each waited for.
#
# The gate runs on the node this worktree holds, when it holds one — keep it
# rather than releasing it first; otherwise it takes the fastest free node.
#
# ## One landing at a time (2026-10-17)
#
# Before it rebases, a landing takes **the turn to land** at the midas hub
# (`midas land take`, first come first served) and keeps it until its push to
# `main` is done, renewing it every minute. Without it, a landing rebased,
# waited ~15 minutes for a gate node while the one ahead landed, then gated a
# base that was already gone and was bounced at the push — at least six green
# gates were thrown away that way in one week. So a landing in progress is
# never overtaken by one that asked later; `midas land status` shows the line.
# Should `main` still move under it — a push that did not come through here —
# it rebases and gates again *keeping the turn*, up to three times, rather than
# giving its place up. A midas without `land` lands without a turn, as before.
#
# ## Why there is no pull request any more (2026-08-30)
#
# There used to be one, and it was the only way to get a verdict: `ci.yml` has no
# push trigger on branches, so a branch's run started when its PR was opened.
# That made every landing cost two full runs of a 15-25 minute workflow on a
# runner with capacity 3 — once on the pull-request ref, once on the merge commit
# — for one tree. And it was increasingly not even read: of the eight merges
# before this change, five went from PR opened to PR merged in under six seconds.
# The pull request was not a review, it was a way to start a build and then not
# wait for it.
#
# So the verdict moved to where the code already is. `verify-branch` runs the
# same commands out of the same workflow file, here, and this script refuses a
# head it has not passed. What lands on `main` has been tested; what it has not
# been is tested *by something outside this machine* — see that script's header
# and docs/notes/agent-verification.md, both of which say so in as many words.
# CI has not been switched off: it runs on `main` nightly (on every push until
# 2026-10-16), with the render smokes and both cross-target lanes that a pull
# request never had. Its verdict arrives after the landing, and a red one is
# fixed forward. The gate's pass is also recorded at the midas hub, which is
# what `midas deploy` asks for before it publishes a commit.
#
# ## What it still refuses
#
#   * a dirty worktree — commit first, so what is verified is what lands. A
#     checkout several sessions share is always dirty with somebody's work:
#     land from the session's own worktree (docs/workflow.md);
#   * a detached HEAD — there is no branch name to push it under;
#   * a `wip:` commit on the branch — what `handover` sweeps up for the next
#     session, which folds it into real commits before landing;
#   * a migration, protocol revision or message kind number that main (or the
#     live database) already holds as something else — `check-numbers.ts`;
#   * a head with no `verify-branch` receipt (`--allow-unverified` is the escape
#     hatch, and it exists to be visible in a transcript, not to be routine);
#   * a `main` that has moved since the rebase — the push is a plain
#     fast-forward, so a concurrent landing bounces it and you re-run.
#
# ## Tokens
#
# None. `main` is not protected, so the code goes up as an ordinary SSH push
# under this account, and nothing here calls the Forgejo API. It used to close
# the branch's Forgejo issue; that went with the tickets on 2026-10-17, when
# work moved to sessions (docs/workflow.md).

set -uo pipefail

argv=("$@")
scope="auto"
dry_run=""
verify_only=""
allow_unverified=""
deploy=""
while [ $# -gt 0 ]; do
    case "$1" in
        --scope)             scope="$2"; shift 2 ;;
        --dry-run)           dry_run=1; shift ;;
        --verify-only)       verify_only=1; shift ;;
        --allow-unverified)  allow_unverified=1; shift ;;
        --deploy)            deploy="$2"; shift 2 ;;
        -h|--help) sed -n '2,72p' "$0"; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

here=$(cd "$(dirname "$0")" && pwd)
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
gitdir=$(git rev-parse --git-dir)

# ── Which branch ─────────────────────────────────────────────────────────────
# The one this worktree has checked out, which a handover and the next session
# know the work by.
branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" != "HEAD" ] || {
    echo "refusing: detached HEAD — check out a branch first (git switch -c <type>/<slug>)" >&2
    exit 1; }
[ "$branch" != "main" ] || { echo "refusing: this worktree is on main itself" >&2; exit 1; }

echo "branch   $branch"

if [ -n "$(git status --porcelain)" ]; then
    echo "refusing: uncommitted changes — commit them first" >&2
    git status --short >&2
    exit 1
fi

# ── The turn to land ─────────────────────────────────────────────────────────
# Taken here, before the fetch, so that what the gate tests is the `main` this
# landing pushes onto. A re-run of this script by itself (below, when `main`
# moved anyway) already holds it, and asking again only renews it.
# `--verify-only` and `--dry-run` push nothing, so they wait for nobody.
step() { :; }
if [ -z "$verify_only$dry_run" ] && command -v midas >/dev/null; then
    if midas land --help >/dev/null 2>&1; then
        echo "==> taking the turn to land (midas land status shows the line)"
        midas land take --purpose "landing $branch"; took=$?
    fi
    if [ "${took:-69}" -eq 0 ]; then
        land_outcome="abandoned"; land_sha=""
        # Every minute, for as long as this script lives — `kill -0 $$` ends
        # it when the script is killed outright and no trap runs, so the turn
        # still lapses on the hub instead of being renewed by an orphan.
        ( while sleep 60 && kill -0 $$ 2>/dev/null; do midas land renew >/dev/null 2>&1; done ) &
        renewer=$!
        disown "$renewer"   # stopped below by pid; no "Terminated" notice when it is
        trap 'kill "$renewer" 2>/dev/null; midas land release --outcome "$land_outcome" ${land_sha:+--sha "$land_sha"} >/dev/null 2>&1' EXIT
        step() { midas land renew --step "$1" >/dev/null 2>&1 || true; }
    elif [ "${took:-69}" -eq 69 ]; then
        echo "note: no landing queue here (\`midas land\`, at the hub) — landing without a turn" >&2
    else
        echo "no turn to land came within two hours — run it again later" >&2; exit 1
    fi
fi

# ── Rebase onto whatever main is now ─────────────────────────────────────────
# `main` moves under a session: it is the whole reason `rebase-before-starting`
# is a standing note. Rebasing rather than merging also means `main` gains the
# branch's own commits and no merge bubble, so `git log` reads as the sequence of
# changes it actually is. A conflict stops here — resolving one is a judgement
# about two people's work and not something to automate.
step "rebasing onto main"
echo "==> fetching origin/main"
git fetch --quiet origin main || { echo "could not fetch origin" >&2; exit 1; }
if [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ]; then
    echo "refusing: HEAD is already exactly origin/main — nothing to land" >&2
    exit 1
fi

# ── Hand-numbered things ─────────────────────────────────────────────────────
# Before the rebase, not after: a migration, a protocol revision or a message
# kind that main has since claimed as something else rebases *clean* — different
# files, or different lines — and the clash would only surface as a simulator
# that will not start or two messages on one wire number. `check-numbers.ts`
# compares what each side added since they split, and reads the live migration
# history when `ssh host` works.
echo "==> checking migration, protocol and message-kind numbers"
if ! bun "$here/check-numbers.ts" --base origin/main; then
    echo "" >&2
    echo "not landing: renumber as above, commit, and re-run." >&2
    exit 1
fi

if ! git merge-base --is-ancestor origin/main HEAD; then
    ahead=$(git rev-list --count HEAD ^origin/main)
    behind=$(git rev-list --count origin/main ^HEAD)
    echo "==> main has moved: $behind commit(s) to catch up, $ahead of ours — rebasing"
    if ! git rebase origin/main; then
        echo "" >&2
        echo "the rebase conflicts with main — resolve it, then re-run:" >&2
        echo "    git status; git rebase --continue" >&2
        echo "if main already landed the same change, that is 'git rebase --skip'," >&2
        echo "not a merge of two versions of one change." >&2
        exit 1
    fi
    echo "    rebased onto $(git rev-parse --short origin/main)"
fi

# ── Handover sweeps ──────────────────────────────────────────────────────────
# `handover` leaves a `wip:` commit holding whatever a session had not
# committed, and the note for the next one. It is a sweep, not a change anyone
# would review, and with no pull request there is nothing after this point that
# would stop one reaching `main`.
wip=$(git log --format='%h %s' origin/main..HEAD | grep -E '^[0-9a-f]+ wip:' || true)
if [ -n "$wip" ]; then
    echo "refusing: the branch still carries wip commits — fold them into real commits first:" >&2
    printf '    %s\n' "$wip" >&2
    echo "(the handover skill says how: .claude/skills/handover/SKILL.md)" >&2
    exit 1
fi

sha=$(git rev-parse HEAD)
echo "head     $sha"
echo "landing  $(git rev-list --count HEAD ^origin/main) commit(s)"

# ── The gate ─────────────────────────────────────────────────────────────────
# The receipt is keyed on the sha, so the rebase above invalidates a pass earned
# before it — which is the point. A verified tree that has since been replayed
# onto different code has not been verified.
receipt="$gitdir/cartopolis-verified"
verified=""
[ -f "$receipt" ] && verified=$(sed -n 's/^sha=//p' "$receipt" | head -1)

if [ "$verified" = "$sha" ]; then
    echo "==> already verified at $(sed -n 's/^at=//p' "$receipt") — steps:$(sed -n 's/^steps=//p' "$receipt")"
elif [ -n "$allow_unverified" ]; then
    # Only ever on an explicit human instruction, and loud in the transcript
    # because it is the one decision this path is not allowed to make for itself.
    echo "==> --allow-unverified: landing without running the gate"
else
    echo "==> running the gate (verify-branch --scope $scope)"
    step "gating ${sha:0:8}"
    "$here/verify-branch" --scope "$scope" || {
        land_outcome="failed"
        echo "" >&2
        echo "not landing: the gate is red. Fix it and re-run." >&2
        exit 1; }
fi

[ -n "$verify_only" ] && { echo "--verify-only: stopping before the push"; exit 0; }
[ -n "$dry_run" ] && { echo "(dry run: would push $branch and fast-forward main to ${sha:0:8})"; exit 0; }

# ── Land it ──────────────────────────────────────────────────────────────────
# The branch goes up first and keeps existing, so what landed can still be found
# by the name the session worked under.
# Plain first, `--force-with-lease` only as the fallback. A lease needs a
# remote-tracking ref to compare against and a branch that has never been pushed
# has none, so leading with it fails on exactly the common case; and the only
# reason a plain push is rejected here is the rebase above, which is precisely
# when overwriting our own branch is what we mean.
echo "==> pushing $branch"
if ! git push --quiet origin "HEAD:refs/heads/$branch" 2>/dev/null; then
    git push --force-with-lease --quiet origin "HEAD:refs/heads/$branch" || {
        echo "could not push the branch" >&2; exit 1; }
    echo "    (force-with-lease, after the rebase)"
fi

# No `--force` anywhere near this one. A plain push is a fast-forward or a
# rejection, and a rejection here means another session landed between the fetch
# above and now — the right answer to which is to re-run, not to overwrite them.
echo "==> fast-forwarding main to ${sha:0:8}"
step "pushing ${sha:0:8}"
if ! git push --quiet origin "HEAD:refs/heads/main"; then
    echo "" >&2
    # With the turn held, only a push that did not come through the queue can
    # do this. Go round again keeping the turn — `exec` runs no EXIT trap, so
    # nothing is released, and the renewer is keyed on this same pid.
    attempt=${CARTO_LAND_ATTEMPT:-1}
    if [ -n "${renewer:-}" ] && [ "$attempt" -lt 3 ]; then
        echo "main moved outside the landing queue — rebasing and gating again, keeping the turn" >&2
        CARTO_LAND_ATTEMPT=$((attempt + 1)) exec "$0" "${argv[@]}"
    fi
    echo "main was updated while this ran. Re-run — the rebase above will pick it up." >&2
    exit 1
fi
echo "    main is now ${sha:0:8}"

# The turn goes back now, not after the deploys below: the next landing's base
# is this commit, and nothing a deploy does can move it.
if [ -n "${renewer:-}" ]; then
    land_outcome="landed"; land_sha="$sha"
    kill "$renewer" 2>/dev/null
    midas land release --outcome landed --sha "$sha" >/dev/null 2>&1
    trap - EXIT
fi

echo
echo "done. The gate's receipt is at the midas hub; CI runs on main tonight."
if [ -z "$deploy" ]; then
    echo "Deploy what changed with: midas deploy sim|atlas|web|wasm|apk"
    exit 0
fi

# ── Deploy ───────────────────────────────────────────────────────────────────
# Asked for by name, after the landing, so a failed deploy never undoes one:
# main has the commit either way, and the failing target says what to re-run.
deploy_failed=""
for target in ${deploy//,/ }; do
    echo
    echo "==> midas deploy $target at ${sha:0:8}"
    midas deploy "$target" --sha "$sha" || deploy_failed="$deploy_failed $target"
done
if [ -n "$deploy_failed" ]; then
    echo "landed, but the deploy failed for:$deploy_failed — re-run: midas deploy <target> --sha $sha" >&2
    exit 1
fi
