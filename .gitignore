target
data
.env

# Local OSM tile/building cache. Unanchored (no leading slash) so it matches at
# any depth — the cache path is cwd-relative (`PathBuf::from("cache")`), so running
# the client from a crate dir writes `crates/cartopolis/cache/`, not just repo-root.
cache/

# ADR-016 solo/dev credentials (never commit)
data/dev-login.toml

# Legacy Quaternius packs (CC0), superseded by `characters/` (which is committed via
# Git LFS). Fetched by hand, not committed — deletable. See assets/README.md.
assets/models/avatar/base/
assets/models/avatar/outfits/
assets/models/avatar/anims/
assets/models/avatar/License_Standard.txt

# Trunk output for the web build (`crates/cartopolis/serve-threads.sh`). Build
# artifact, and a large one — the wasm module alone is >100 MB unoptimised.
dist/

# Git worktrees for parallel agent threads. Nested inside the repo by some
# tooling, so `git add -A` would otherwise sweep an entire second checkout into
# a commit.
.claude/worktrees/
